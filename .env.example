HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/stablecoin-payments.db
POLL_INTERVAL_MS=15000
RPC_REQUEST_TIMEOUT_MS=5000
TARGET_ERROR_RETRY_MS=60000
HTTP_CACHE_TTL_MS=5000
CACHE_MAX_ENTRIES=256
BODY_LIMIT_KB=64
ENABLED_CHAINS=ethereum,polygon,base,optimism,arbitrum,bsc,megaeth,monad
ADMIN_UI_ENABLED=true
ALLOWED_ORIGINS=

# Production safety: set at least one strong random token.
# Example: openssl rand -hex 32
AUTH_TOKENS=

# In production the service refuses to start without AUTH_TOKENS unless this is true.
ALLOW_INSECURE_NO_AUTH_IN_PRODUCTION=false

# Use dedicated RPC endpoints in production.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
MEGAETH_RPC_URL=
MONAD_RPC_URL=
