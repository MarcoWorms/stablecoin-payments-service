{
  "name": "stablecoin-payments-service",
  "version": "0.1.0",
  "description": "Drop-in service for tracking finalized stablecoin payments to watched EVM addresses.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "stablecoins",
    "payments",
    "evm",
    "usdc",
    "usdt",
    "fastify",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "better-sqlite3": "^12.8.0",
    "fastify": "^5.8.4",
    "viem": "^2.47.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
